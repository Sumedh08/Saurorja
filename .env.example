# Copy to .env for local development. These values are public examples, not secrets.
APP_NAME=Saurorja API
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api/v1
POSTGRES_DB=saurorja
POSTGRES_USER=saurorja
POSTGRES_PASSWORD=saurorja-dev-password
DATABASE_URL=postgresql+psycopg://saurorja:saurorja-dev-password@localhost:5432/saurorja
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=saurorja
MINIO_SECRET_KEY=saurorja-dev-secret
MINIO_BUCKET=saurorja
OTEL_SERVICE_NAME=saurorja-api
# Leave blank to disable OpenTelemetry export. Set to an OTLP HTTP collector endpoint to enable.
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost"]
PUBLIC_APP_ORIGIN=http://localhost
# Leave OIDC values blank until a self-hosted generic OIDC provider is configured.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_SCOPES=openid email profile
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=saurorja-grafana-dev
